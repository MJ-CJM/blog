blog.mj-cjm.com {
    root * /var/www/blog
    encode gzip zstd

    @assets path /_astro/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    try_files {path} {path}/index.html {path}.html
    file_server

    handle_errors {
        @404 expression {err.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
}
